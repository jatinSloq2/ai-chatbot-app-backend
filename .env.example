# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/authdb?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cookies
COOKIE_SECURE=false

# Nodemailer (use Gmail App Password, or a transactional provider like Resend/SendGrid SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="MyApp <no-reply@myapp.com>"

# OTP
OTP_EXPIRES_MINUTES=10

# Firebase Admin (Google login) - get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100

# Encryption key for storing user-provided LLM/embedding API keys (BYOK).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string

# Ollama (free/default LLM + embedding provider - must be reachable from your server)
OLLAMA_BASE_URL=http://localhost:11434

# Razorpay (billing - supports INR by default; USD requires international payments
# enabled on your Razorpay account)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# --- Email OAuth2 ("Connect Gmail" / "Connect Outlook") ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google/callback

OAUTH_STATE_SECRET=replace_with_a_long_random_string

# --- WhatsApp Cloud API webhook ---
# WHATSAPP_VERIFY_TOKEN: any string you make up yourself — paste the SAME
# value into the Meta App dashboard's webhook "Verify Token" field. Used
# only for the one-time GET verification handshake.
WHATSAPP_VERIFY_TOKEN=your_own_made_up_verify_token
# WHATSAPP_APP_SECRET: from Meta App dashboard -> Settings -> Basic -> App
# Secret. Used to verify the X-Hub-Signature-256 header on every incoming
# POST so we know it genuinely came from Meta. Webhook still accepts events
# without this set (with a warning logged) so local/ngrok testing isn't
# blocked, but this MUST be set before production.
WHATSAPP_APP_SECRET=your_meta_app_secret

# --- WhatsApp Embedded Signup ("Continue with Facebook" — Meta's official
# onboarding popup, replacing/augmenting the manual paste-your-own-App form
# above). This is OUR platform's own Meta Tech Provider App — every tenant
# who completes embedded signup shares this one App, unlike the manual
# path where each tenant brings their own.
#   META_APP_ID / META_APP_SECRET: from Meta App Dashboard -> Settings -> Basic,
#     on OUR app (a Tech Provider / Business app with WhatsApp Embedded
#     Signup enabled), not any individual tenant's.
#   META_CONFIG_ID: the WhatsApp "Login configuration" id created under
#     Meta App Dashboard -> WhatsApp -> Embedded Signup -> Configurations.
#     This is what makes FB.login() show the WhatsApp onboarding flow
#     instead of a generic Facebook Login screen.
#   META_GRAPH_VERSION: Graph API version used for all embedded-signup
#     calls (token exchange, subscribed_apps, phone number lookup).
META_APP_ID=your_meta_tech_provider_app_id
META_APP_SECRET=your_meta_tech_provider_app_secret
META_CONFIG_ID=your_whatsapp_embedded_signup_config_id
META_GRAPH_VERSION=v21.0

# --- Inbox platform SSO ---
# The team-inbox / conversations UI is hosted as a SEPARATE app (own domain,
# own backend/session system). Clicking "Open inbox" on a connected
# WhatsApp number mints a short-lived signed token here and redirects the
# browser to INBOX_PLATFORM_URL with it, so the user doesn't have to log in
# again over there. INBOX_SSO_SECRET must be the SAME value configured on
# the Inbox backend (it verifies tokens signed with this secret) — treat it
# like any other shared signing secret, rotate on both sides together.
INBOX_PLATFORM_URL=https://inbox.yourplatform.com
INBOX_SSO_SECRET=replace_with_a_long_random_string_shared_with_the_inbox_backend
INBOX_SSO_AUDIENCE=jestbot-inbox